# --- compose ---
COMPOSE_PROJECT_NAME=os
COMPOSE_FILE=compose/node_b.compose.yaml

# --- minio ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
JENKINS_S3_ACCESS_KEY=
JENKINS_S3_SECRET_KEY=
OPENHUB_S3_ACCESS_KEY=
OPENHUB_S3_SECRET_KEY=

# --- lgtm / Grafana ---
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=
NGINX_STATUS_ENDPOINT=http://10.9.0.1:8080/nginx_status

# --- hostmetrics на B ---
# Пустой OTEL_HOST_NAME в compose подменяется на oscript.io.
# DOCKER_GID — число из `getent group docker | cut -d: -f3`, не текст команды.
OTEL_HOST_NAME=oscript-b
DOCKER_GID=
