# Управляется Ansible. Не править вручную на проде без согласования.
COMPOSE_PROJECT_NAME={{ project_name }}
COMPOSE_FILE={{ compose_file_env }}

publish_secret={{ publish_secret }}
TELEGRAM_TOKEN={{ TELEGRAM_TOKEN }}
S3_ACCESS_KEY_ID={{ S3_ACCESS_KEY_ID }}
S3_SECRET_ACCESS_KEY={{ S3_SECRET_ACCESS_KEY }}
S3_BUCKET={{ S3_BUCKET }}
OPENHUB_DB_PASSWORD={{ OPENHUB_DB_PASSWORD }}
OPENHUB_S3_ACCESS_KEY={{ OPENHUB_S3_ACCESS_KEY }}
OPENHUB_S3_SECRET_KEY={{ OPENHUB_S3_SECRET_KEY }}
GRAFANA_ADMIN_PASSWORD={{ GRAFANA_ADMIN_PASSWORD }}
GRAFANA_DB_PASSWORD={{ GRAFANA_DB_PASSWORD }}
MINIO_ROOT_USER={{ MINIO_ROOT_USER }}
MINIO_ROOT_PASSWORD={{ MINIO_ROOT_PASSWORD }}
JENKINS_S3_ACCESS_KEY={{ JENKINS_S3_ACCESS_KEY }}
JENKINS_S3_SECRET_KEY={{ JENKINS_S3_SECRET_KEY }}
{% if nginx_status_endpoint is defined and (nginx_status_endpoint | string | length) > 0 %}
NGINX_STATUS_ENDPOINT={{ nginx_status_endpoint }}
{% endif %}
OTEL_HOST_NAME={{ otel_host_name }}
DOCKER_GID={{ app_docker_gid }}
