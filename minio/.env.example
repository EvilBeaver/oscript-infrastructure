# Скопируйте в .env в корне репозитория (файл в .gitignore) и задайте значения на сервере.

# Root-учётка MinIO (только администрирование, не для Jenkins)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password

# Сервисный пользователь для Jenkins Artifact Manager on S3
JENKINS_S3_ACCESS_KEY=jenkins-artifacts
JENKINS_S3_SECRET_KEY=change-me-strong-secret

# --- Параметры для Jenkins (Manage Jenkins → AWS / Artifact Management) ---
# Custom Endpoint:     https://s3.oscript.io
#                      (внутри docker-сети: http://minio:9000)
# Bucket:              jenkins-artifacts
# Signing region:      us-east-1
# Use Path Style URL:  включить
# Disable session token: включить
# Credentials:         JENKINS_S3_ACCESS_KEY / JENKINS_S3_SECRET_KEY
