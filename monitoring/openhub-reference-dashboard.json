    {
      "type": "table",
      "title": "Что где лежит",
      "description": "Пулы хаба: сколько места занимают их артефакты сейчас и что с ними происходило за выбранный период — скачивания, публикации, версии, пришедшие через зеркало. Считается по счётчикам процессов хаба за выбранный период; Prometheus хранит 15 дней, дальше в прошлое период не дотянется.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Занято в хранилище"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Скачиваний за период"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Публикаций за период"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Версий через зеркало"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Занято в хранилище",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (oshub_pool) ((oshub_storage_used_bytes{service_name=\"openhub\"} and on (host_name) topk(1, timestamp(oshub_storage_used_bytes{service_name=\"openhub\"}))))",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (oshub_pool) (increase(oshub_downloads_total{service_name=\"openhub\"}[$__range])) or sum by (oshub_pool) ((oshub_storage_used_bytes{service_name=\"openhub\"} and on (host_name) topk(1, timestamp(oshub_storage_used_bytes{service_name=\"openhub\"})))) * 0",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (oshub_pool) (sum_over_time((clamp_min(last_over_time(oshub_publications_total{service_name=\"openhub\"}[3h]) - (last_over_time(oshub_publications_total{service_name=\"openhub\"}[3h] offset 1m) or last_over_time(oshub_publications_total{service_name=\"openhub\"}[3h]) * 0), 0))[$__range:1m])) or sum by (oshub_pool) ((oshub_storage_used_bytes{service_name=\"openhub\"} and on (host_name) topk(1, timestamp(oshub_storage_used_bytes{service_name=\"openhub\"})))) * 0",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (oshub_pool) (sum_over_time((clamp_min(last_over_time(oshub_mirror_versions_total{service_name=\"openhub\"}[3h]) - (last_over_time(oshub_mirror_versions_total{service_name=\"openhub\"}[3h] offset 1m) or last_over_time(oshub_mirror_versions_total{service_name=\"openhub\"}[3h]) * 0), 0))[$__range:1m])) or sum by (oshub_pool) ((oshub_storage_used_bytes{service_name=\"openhub\"} and on (host_name) topk(1, timestamp(oshub_storage_used_bytes{service_name=\"openhub\"})))) * 0",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "oshub_pool": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "oshub_pool": "Пул",
              "Value #A": "Занято в хранилище",
              "Value #B": "Скачиваний за период",
              "Value #C": "Публикаций за период",
              "Value #D": "Версий через зеркало"
            }
          }
        }
      ],
