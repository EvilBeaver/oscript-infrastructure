# SALVAGE. Дополнить при реализации: DOCKER_GID, JENKINS_S3_* если Jenkins
# ходит в MinIO не через https://s3.oscript.io (см. ТЗ §секреты).

# --- compose ---
COMPOSE_PROJECT_NAME=os
COMPOSE_FILE=compose/node_a.compose.yaml

# --- tg_bot ---
TELEGRAM_TOKEN=

# --- s3-sync (внешний S3, не MinIO) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- openhub / openhub_db ---
OPENHUB_DB_PASSWORD=
OPENHUB_S3_ACCESS_KEY=
OPENHUB_S3_SECRET_KEY=

# --- hostmetrics ---
OTEL_HOST_NAME=
DOCKER_GID=
