# Добавьте в .env в корне репозитория и задайте значения на сервере.

# Пароль базы хаба; применяется только при первом запуске. Без точки с запятой.
OPENHUB_DB_PASSWORD=change-me-strong-password

# Учётка хаба в MinIO; её и бакет openhub заводят руками
OPENHUB_S3_ACCESS_KEY=openhub
OPENHUB_S3_SECRET_KEY=change-me-strong-secret

# Обязателен: Grafana смотрит в интернет (grafana.oscript.io)
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
